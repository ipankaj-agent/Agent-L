{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",

    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],

    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,

    "rootDir": "./src/linkagent/ui",
    "outDir": "./src/linkagent/ui/dist"
  },
  "include": [
    "src/linkagent/ui/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/linkagent/ui/dist"
  ]
}